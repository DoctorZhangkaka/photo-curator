# 复制为 .env 后按需修改；.env 已在 .gitignore 中，绝不要提交真实路径、令牌或密钥。

# 照片根目录（默认 /Users/eason/Desktop/相册）。
# 自动化测试必须指向 /tmp 下的临时目录，切勿指向真实相册。
PHOTO_CURATOR_ROOT=/Users/eason/Desktop/相册

# 应用数据目录：SQLite、预览缓存、本地会话令牌（默认 <repo>/data）。
PHOTO_CURATOR_DATA_DIR=./data

# 精选导出目录名称（固定位于照片根目录内）。
PHOTO_CURATOR_EXPORT_DIR_NAME=精选原相册

# 后端仅监听回环地址；不要改成 0.0.0.0。
PHOTO_CURATOR_HOST=127.0.0.1
PHOTO_CURATOR_PORT=8765
PHOTO_CURATOR_WEB_HOST=127.0.0.1
PHOTO_CURATOR_WEB_PORT=7100

# 启动时后台扫描全部相册（测试通常设为 0）。
PHOTO_CURATOR_STARTUP_SCAN=1

# RAW 解码并发（1-2 较稳妥，避免内存峰值）。
PHOTO_CURATOR_PREVIEW_CONCURRENCY=2

# 允许的 Host（防 DNS rebinding）。
PHOTO_CURATOR_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# 可选：ExifTool 路径。未安装时 RAW-only 的 EXIF/拍摄时间回退为文件名排序。
# PHOTO_CURATOR_EXIFTOOL=/opt/homebrew/bin/exiftool

# 仅测试可用：固定本地会话令牌。生产不要设置，应用会自动生成并写入 data/session-token。
# PHOTO_CURATOR_SESSION_TOKEN=
